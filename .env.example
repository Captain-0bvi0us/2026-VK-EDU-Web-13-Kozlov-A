# Локально (runserver на хосте): скопируйте в .env.local, POSTGRES_HOST=localhost, REDIS_HOST=localhost и т.п.
# Docker: скопируйте в .env.docker и оставьте имена сервисов (db/redis/centrifugo/maildev).

# --- Django ---
DJANGO_SECRET_KEY=ваш-секретный-код
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL ---
POSTGRES_DB=cupofq
POSTGRES_USER=cupofq
POSTGRES_PASSWORD=замените-на-сильный-латинский-пароль
# Хост: localhost для запуска на хосте, db — в docker compose
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Redis (брокер celery, cache backend django, redbeat schedule) ---
# Хост: localhost для запуска на хосте, redis — в docker compose
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CACHE_DB=1
REDIS_BROKER_DB=2
REDIS_BEAT_DB=3

# --- Celery ---
# Имя очереди по умолчанию и таймзона
CELERY_TIMEZONE=Europe/Moscow

# --- Centrifugo (realtime) ---
# Хост: http://localhost:8001 для запуска на хосте; http://centrifugo:8000 — в docker compose
CENTRIFUGO_API_URL=http://localhost:8001/api
CENTRIFUGO_API_KEY=замените-на-секрет
CENTRIFUGO_HMAC_SECRET_KEY=замените-на-секрет
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=замените-на-секрет
CENTRIFUGO_ADMIN_PASSWORD=admin
CENTRIFUGO_ADMIN_SECRET=замените-на-секрет-для-admin-jwt
CENTRIFUGO_NAMESPACE=questions
# WebSocket-эндпоинт, который видит браузер (с хоста или через nginx)
CENTRIFUGO_WS_URL=ws://localhost:8001/connection/websocket

# --- Email (SMTP / maildev) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CupOfQ <noreply@cupofq.local>
