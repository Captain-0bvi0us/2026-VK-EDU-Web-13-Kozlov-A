# Локально (runserver на хосте): скопируйте в .env.local, POSTGRES_HOST=localhost; поднимите Postgres.
# Docker: скопируйте в .env.docker с теми же POSTGRES_* что у контейнера db. 

# --- Django ---
DJANGO_SECRET_KEY=ваш-секретный-код
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- PostgreSQL ---
POSTGRES_DB=cupofq
POSTGRES_USER=cupofq
POSTGRES_PASSWORD=замените-на-сильный-латинский-пароль
# --- На хосте ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
